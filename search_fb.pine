// ════════════════════════════════════════════════════════════════════════════
//  Search FB – Failed Breakdown & Failed Breakout su E-mini S&P 500
//  Pine Script v6  |  Compatibile con tutti i timeframe
//  Ottimizzato per 3 min e 15 min su ES / MES
//
//  CONCETTI CHIAVE
//  ───────────────────────────────────────────────────────────────────────────
//  Minimo/Massimo Significativo:
//    Pivot dove almeno N barre a sinistra e N a destra hanno
//    low più alto / high più basso. Livello di supporto/resistenza rilevante.
//
//  Failed Breakdown (FB) – Long:
//    1. Il prezzo scende sotto un Minimo Significativo  → breakdown
//    2. Entro la finestra, il prezzo recupera sopra     → breakdown fallito
//    3. Short intrappolati alimentano il rialzo         → entry long
//    Invalidazione: prezzo scende sotto il bdLow originale
//
//  Failed Breakout (FBO) – Short:
//    1. Il prezzo sale sopra un Massimo Significativo   → breakout
//    2. Entro la finestra, il prezzo rientra sotto      → breakout fallito
//    3. Long intrappolati alimentano il ribasso         → entry short
//    Invalidazione: prezzo sale sopra il boHigh originale
// ════════════════════════════════════════════════════════════════════════════
//@version=6
strategy("Search FB – Failed Breakdown & Breakout",
         shorttitle              = "Search FB",
         overlay                 = true,
         initial_capital         = 100000,
         default_qty_type        = strategy.fixed,
         default_qty_value       = 1,
         commission_type         = strategy.commission.cash_per_contract,
         commission_value        = 2.05,
         slippage                = 1,
         pyramiding              = 0,
         process_orders_on_close = false,
         calc_on_order_fills     = false,
         max_lines_count         = 500,
         max_labels_count        = 500)

// ════════════════════════════════════════════════════════════════════════════
//  I N P U T S
// ════════════════════════════════════════════════════════════════════════════

var string G_SL  = "📍 Minimi Significativi (Significant Lows)"
var string G_FB  = "⚡ Failed Breakdown (Long)"
var string G_RM  = "🎯 Risk Management – Long (FB)"
var string G_SH  = "📍 Massimi Significativi (Significant Highs)"
var string G_FBO = "⚡ Failed Breakout (Short)"
var string G_RMS = "🎯 Risk Management – Short (FBO)"
var string G_SS  = "🕐 Sessione"
var string G_VIS = "🎨 Visuals"

// ── Minimi Significativi ─────────────────────────────────────────────────────
i_pivLeft  = input.int   (5,   "Barre sinistra pivot",
             minval=1, maxval=50, group=G_SL,
             tooltip="Numero di barre a sinistra del candidato minimo, tutte con low più alto.")
i_pivRight = input.int   (3,   "Barre destra pivot (conferma)",
             minval=1, maxval=50, group=G_SL,
             tooltip="Barre a destra per confermare il pivot. Introduce un ritardo di i_pivRight barre.")
i_maxLows  = input.int   (5,   "Numero massimo minimi attivi",
             minval=1, maxval=10, group=G_SL)
i_minGap   = input.float (2.0, "Gap minimo tra livelli (punti)",
             minval=0.25, step=0.25, group=G_SL,
             tooltip="Evita livelli doppi nella stessa area di prezzo.")

// ── Failed Breakdown (Long) ──────────────────────────────────────────────────
i_bkdClose = input.bool  (true, "Breakdown richiede CLOSE sotto il minimo",
             group=G_FB,
             tooltip="ON → chiusura sotto il livello.\nOFF → basta il wick (low).")
i_recClose = input.bool  (true, "Recupero richiede CLOSE sopra il minimo",
             group=G_FB,
             tooltip="ON → chiusura sopra il livello.\nOFF → basta il wick (high).")
i_maxBars  = input.int   (8,   "Finestra temporale recupero (barre)",
             minval=2, maxval=200, group=G_FB,
             tooltip="Barre entro cui il prezzo deve recuperare, altrimenti è breakdown reale.")

// ── Risk Management Long ─────────────────────────────────────────────────────
i_slTicks  = input.int   (4,   "Tick aggiuntivi Stop (sotto BD Low)",
             minval=1, maxval=200, group=G_RM,
             tooltip="Stop = bdLow − (N × tick size).")
i_rrRatio  = input.float (2.0, "Risk / Reward Ratio",
             minval=0.5, maxval=20.0, step=0.5, group=G_RM)
i_tickSz   = input.float (0.25, "Tick Size",
             minval=0.01, group=G_RM,
             tooltip="ES e MES: 0.25 punti per tick.")

// ── Massimi Significativi ────────────────────────────────────────────────────
i_pivLeftH  = input.int   (5,   "Barre sinistra pivot",
              minval=1, maxval=50, group=G_SH,
              tooltip="Numero di barre a sinistra del candidato massimo, tutte con high più basso.")
i_pivRightH = input.int   (3,   "Barre destra pivot (conferma)",
              minval=1, maxval=50, group=G_SH,
              tooltip="Barre a destra per confermare il pivot. Introduce un ritardo di i_pivRightH barre.")
i_maxHighs  = input.int   (5,   "Numero massimo massimi attivi",
              minval=1, maxval=10, group=G_SH)
i_minGapH   = input.float (2.0, "Gap minimo tra livelli (punti)",
              minval=0.25, step=0.25, group=G_SH,
              tooltip="Evita livelli doppi nella stessa area di prezzo.")

// ── Failed Breakout (Short) ──────────────────────────────────────────────────
i_bkdCloseH = input.bool  (true, "Breakout richiede CLOSE sopra il massimo",
              group=G_FBO,
              tooltip="ON → chiusura sopra il livello.\nOFF → basta il wick (high).")
i_recCloseH = input.bool  (true, "Rientro richiede CLOSE sotto il massimo",
              group=G_FBO,
              tooltip="ON → chiusura sotto il livello.\nOFF → basta il wick (low).")
i_maxBarsH  = input.int   (8,   "Finestra temporale rientro (barre)",
              minval=2, maxval=200, group=G_FBO,
              tooltip="Barre entro cui il prezzo deve rientrare, altrimenti è breakout reale.")

// ── Risk Management Short ────────────────────────────────────────────────────
i_slTicksH = input.int   (4,   "Tick aggiuntivi Stop (sopra BO High)",
             minval=1, maxval=200, group=G_RMS,
             tooltip="Stop = boHigh + (N × tick size).")
i_rrRatioH = input.float (2.0, "Risk / Reward Ratio",
             minval=0.5, maxval=20.0, step=0.5, group=G_RMS)

// ── Sessione ─────────────────────────────────────────────────────────────────
i_useSession = input.bool   (true,              "Filtra per sessione RTH", group=G_SS)
i_session    = input.session("0830-1600",       "Sessione (HH:MM)",        group=G_SS)
i_tz         = input.string ("America/New_York","Fuso orario",             group=G_SS)

// ── Visuals ──────────────────────────────────────────────────────────────────
i_showLines  = input.bool  (true,                       "Mostra linee SL/SH",            group=G_VIS)
i_showBG     = input.bool  (true,                       "Sfondo durante BD/BO",          group=G_VIS)
i_showLbls   = input.bool  (true,                       "Mostra etichette prezzo",       group=G_VIS)
i_showTable  = input.bool  (true,                       "Mostra pannello informazioni",  group=G_VIS)
i_colSL      = input.color (color.new(#2962FF, 15),     "Colore linee Minimi Sig.",      group=G_VIS)
i_colSH      = input.color (color.new(#FF6D00, 15),     "Colore linee Massimi Sig.",     group=G_VIS)
i_colFB      = input.color (color.lime,                 "Colore segnale FB (Long)",      group=G_VIS)
i_colFBO     = input.color (color.red,                  "Colore segnale FBO (Short)",    group=G_VIS)
i_colBD      = input.color (color.new(color.red,   85), "Colore sfondo Breakdown",       group=G_VIS)
i_colBO      = input.color (color.new(#FF6D00,     85), "Colore sfondo Breakout",        group=G_VIS)
i_colInvalid = input.color (color.new(color.gray,  20), "Colore segnale invalidato",     group=G_VIS)

// ════════════════════════════════════════════════════════════════════════════
//  S E S S I O N E
// ════════════════════════════════════════════════════════════════════════════
inSession = not i_useSession or not na(time(timeframe.period, i_session, i_tz))

// ════════════════════════════════════════════════════════════════════════════
//  M I N I M I   S I G N I F I C A T I V I
// ════════════════════════════════════════════════════════════════════════════
pivLow = ta.pivotlow(low, i_pivLeft, i_pivRight)

var array<float> sl_lvl  = array.new<float>(0)
var array<int>   sl_bar  = array.new<int>  (0)
var array<line>  sl_line = array.new<line> (0)

if not na(pivLow)
    bool isDup = false
    int  sz    = array.size(sl_lvl)
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(array.get(sl_lvl, i) - pivLow) < i_minGap
                isDup := true
                break
    if not isDup
        int pivBar = bar_index - i_pivRight
        array.unshift(sl_lvl,  pivLow)
        array.unshift(sl_bar,  pivBar)
        newLine = line.new(
             x1=pivBar, y1=pivLow, x2=bar_index, y2=pivLow,
             xloc=xloc.bar_index, color=i_colSL,
             style=line.style_dashed, width=1)
        array.unshift(sl_line, newLine)
        if i_showLbls
            label.new(
                 x=pivBar, y=pivLow,
                 text=str.tostring(pivLow, "#.##"),
                 xloc=xloc.bar_index,
                 style=label.style_label_right,
                 color=color.new(#2962FF, 65),
                 textcolor=color.white, size=size.tiny)
        while array.size(sl_lvl) > i_maxLows
            line.delete(array.pop(sl_line))
            array.pop(sl_lvl)
            array.pop(sl_bar)

if i_showLines and array.size(sl_line) > 0
    for i = 0 to array.size(sl_line) - 1
        line.set_x2(array.get(sl_line, i), bar_index)

f_removeLevel(float lvl) =>
    if array.size(sl_lvl) > 0
        for i = 0 to array.size(sl_lvl) - 1
            if math.abs(array.get(sl_lvl, i) - lvl) < i_tickSz
                line.delete(array.remove(sl_line, i))
                array.remove(sl_bar, i)
                array.remove(sl_lvl, i)
                break

// ════════════════════════════════════════════════════════════════════════════
//  M A S S I M I   S I G N I F I C A T I V I
// ════════════════════════════════════════════════════════════════════════════
pivHigh = ta.pivothigh(high, i_pivLeftH, i_pivRightH)

var array<float> sh_lvl  = array.new<float>(0)
var array<int>   sh_bar  = array.new<int>  (0)
var array<line>  sh_line = array.new<line> (0)

if not na(pivHigh)
    bool isDupH = false
    int  szH    = array.size(sh_lvl)
    if szH > 0
        for i = 0 to szH - 1
            if math.abs(array.get(sh_lvl, i) - pivHigh) < i_minGapH
                isDupH := true
                break
    if not isDupH
        int pivBarH = bar_index - i_pivRightH
        array.unshift(sh_lvl,  pivHigh)
        array.unshift(sh_bar,  pivBarH)
        newLineH = line.new(
             x1=pivBarH, y1=pivHigh, x2=bar_index, y2=pivHigh,
             xloc=xloc.bar_index, color=i_colSH,
             style=line.style_dashed, width=1)
        array.unshift(sh_line, newLineH)
        if i_showLbls
            label.new(
                 x=pivBarH, y=pivHigh,
                 text=str.tostring(pivHigh, "#.##"),
                 xloc=xloc.bar_index,
                 style=label.style_label_right,
                 color=color.new(#FF6D00, 65),
                 textcolor=color.white, size=size.tiny)
        while array.size(sh_lvl) > i_maxHighs
            line.delete(array.pop(sh_line))
            array.pop(sh_lvl)
            array.pop(sh_bar)

if i_showLines and array.size(sh_line) > 0
    for i = 0 to array.size(sh_line) - 1
        line.set_x2(array.get(sh_line, i), bar_index)

f_removeLevelH(float lvl) =>
    if array.size(sh_lvl) > 0
        for i = 0 to array.size(sh_lvl) - 1
            if math.abs(array.get(sh_lvl, i) - lvl) < i_tickSz
                line.delete(array.remove(sh_line, i))
                array.remove(sh_bar, i)
                array.remove(sh_lvl, i)
                break

// ════════════════════════════════════════════════════════════════════════════
//  F A I L E D   B R E A K D O W N  –  M A C C H I N A   A   S T A T I
// ════════════════════════════════════════════════════════════════════════════
var bool  inBD    = false
var float bdLevel = na
var float bdLow   = na
var int   bdBar   = na

float bkdPrice = i_bkdClose ? close : low
float recPrice = i_recClose ? close : high

// STATO 0: Ricerca breakdown
if inSession and not inBD and array.size(sl_lvl) > 0
    float nearestViolated = na
    for i = 0 to array.size(sl_lvl) - 1
        float lvl = array.get(sl_lvl, i)
        if bkdPrice < lvl
            if na(nearestViolated) or lvl > nearestViolated
                nearestViolated := lvl
    if not na(nearestViolated)
        inBD    := true
        bdLevel := nearestViolated
        bdLow   := low
        bdBar   := bar_index

// STATO 1: Gestione breakdown attivo
if inBD
    bdLow := math.min(bdLow, low)
    if bar_index - bdBar >= i_maxBars
        f_removeLevel(bdLevel)
        inBD    := false
        bdLevel := na
        bdLow   := na
        bdBar   := na

// ════════════════════════════════════════════════════════════════════════════
//  F A I L E D   B R E A K O U T  –  M A C C H I N A   A   S T A T I
// ════════════════════════════════════════════════════════════════════════════
var bool  inBO    = false
var float boLevel = na
var float boHigh  = na
var int   boBar   = na

float bkdPriceH = i_bkdCloseH ? close : high
float recPriceH = i_recCloseH ? close : low

// STATO 0: Ricerca breakout
if inSession and not inBO and array.size(sh_lvl) > 0
    float nearestViolatedH = na
    for i = 0 to array.size(sh_lvl) - 1
        float lvl = array.get(sh_lvl, i)
        if bkdPriceH > lvl
            if na(nearestViolatedH) or lvl < nearestViolatedH
                nearestViolatedH := lvl
    if not na(nearestViolatedH)
        inBO    := true
        boLevel := nearestViolatedH
        boHigh  := high
        boBar   := bar_index

// STATO 1: Gestione breakout attivo
if inBO
    boHigh := math.max(boHigh, high)
    if bar_index - boBar >= i_maxBarsH
        f_removeLevelH(boLevel)
        inBO    := false
        boLevel := na
        boHigh  := na
        boBar   := na

// ════════════════════════════════════════════════════════════════════════════
//  S E G N A L I   &   A P E R T U R A   T R A D E
// ════════════════════════════════════════════════════════════════════════════
bool noPos     = strategy.position_size == 0
bool fbSignal  = inBD and recPrice  >= bdLevel and noPos and inSession
bool fboSignal = inBO and recPriceH <= boLevel and noPos and inSession

// ── Riferimenti etichette per invalidazione ───────────────────────────────────
var label lastFBLabel   = na
var float lastFBBdLow   = na
var label lastFBOLabel  = na
var float lastFBOBoHigh = na

// Pulisce il riferimento FB quando la posizione long si chiude (TP hit)
if strategy.position_size == 0 and strategy.position_size[1] > 0
    lastFBLabel  := na
    lastFBBdLow  := na

// Pulisce il riferimento FBO quando la posizione short si chiude (TP hit)
if strategy.position_size == 0 and strategy.position_size[1] < 0
    lastFBOLabel  := na
    lastFBOBoHigh := na

// ── Invalidazione FB: prezzo scende sotto bdLow originale ────────────────────
if not na(lastFBLabel) and not na(lastFBBdLow) and low < lastFBBdLow
    label.set_bgcolor   (lastFBLabel, i_colInvalid)
    label.set_textcolor (lastFBLabel, color.white)
    lastFBLabel := na
    lastFBBdLow := na

// ── Invalidazione FBO: prezzo sale sopra boHigh originale ────────────────────
if not na(lastFBOLabel) and not na(lastFBOBoHigh) and high > lastFBOBoHigh
    label.set_bgcolor   (lastFBOLabel, i_colInvalid)
    label.set_textcolor (lastFBOLabel, color.white)
    lastFBOLabel  := na
    lastFBOBoHigh := na

// ── Segnale FB Long ───────────────────────────────────────────────────────────
if fbSignal
    float entryPx = close
    float stopPx  = bdLow - (i_slTicks * i_tickSz)
    float riskPts = entryPx - stopPx
    float tpPx    = entryPx + riskPts * i_rrRatio

    strategy.entry("FB Long", strategy.long, comment="FB")
    strategy.exit ("FB Exit", from_entry="FB Long",
                   stop=stopPx, limit=tpPx,
                   comment_profit="TP", comment_loss="SL")

    if i_showLbls
        int riskTick = math.round(riskPts / i_tickSz)
        lastFBLabel := label.new(
             x         = bar_index,
             y         = low,
             text      = "⚡ FB\nNiv: "    + str.tostring(bdLevel, "#.##") +
                         "\nEntry: " + str.tostring(entryPx, "#.##") +
                         "\nSL: "    + str.tostring(stopPx,  "#.##") +
                         "\nTP: "    + str.tostring(tpPx,    "#.##") +
                         "\nRisk: "  + str.tostring(riskTick) + " tk",
             xloc      = xloc.bar_index,
             style     = label.style_label_up,
             color     = color.new(i_colFB, 10),
             textcolor = color.black,
             size      = size.small)
        lastFBBdLow := bdLow

    f_removeLevel(bdLevel)
    inBD    := false
    bdLevel := na
    bdLow   := na
    bdBar   := na

// ── Segnale FBO Short ─────────────────────────────────────────────────────────
if fboSignal
    float entryPx = close
    float stopPx  = boHigh + (i_slTicksH * i_tickSz)
    float riskPts = stopPx - entryPx
    float tpPx    = entryPx - riskPts * i_rrRatioH

    strategy.entry("FBO Short", strategy.short, comment="FBO")
    strategy.exit ("FBO Exit",  from_entry="FBO Short",
                   stop=stopPx, limit=tpPx,
                   comment_profit="TP", comment_loss="SL")

    if i_showLbls
        int riskTick = math.round(riskPts / i_tickSz)
        lastFBOLabel := label.new(
             x         = bar_index,
             y         = high,
             text      = "⚡ FBO\nNiv: "   + str.tostring(boLevel, "#.##") +
                         "\nEntry: " + str.tostring(entryPx, "#.##") +
                         "\nSL: "    + str.tostring(stopPx,  "#.##") +
                         "\nTP: "    + str.tostring(tpPx,    "#.##") +
                         "\nRisk: "  + str.tostring(riskTick) + " tk",
             xloc      = xloc.bar_index,
             style     = label.style_label_down,
             color     = color.new(i_colFBO, 10),
             textcolor = color.white,
             size      = size.small)
        lastFBOBoHigh := boHigh

    f_removeLevelH(boLevel)
    inBO    := false
    boLevel := na
    boHigh  := na
    boBar   := na

// ════════════════════════════════════════════════════════════════════════════
//  V I S U A L S
// ════════════════════════════════════════════════════════════════════════════

// Sfondi zona attiva
bgcolor(i_showBG and inBD ? i_colBD : na, title="Zona Breakdown")
bgcolor(i_showBG and inBO ? i_colBO : na, title="Zona Breakout")

// Freccia verde sotto la barra del segnale FB
plotshape(fbSignal,
          title     = "Failed Breakdown Signal",
          location  = location.belowbar,
          style     = shape.triangleup,
          color     = i_colFB,
          size      = size.normal,
          text      = "FB",
          textcolor = color.black)

// Freccia rossa sopra la barra del segnale FBO
plotshape(fboSignal,
          title     = "Failed Breakout Signal",
          location  = location.abovebar,
          style     = shape.triangledown,
          color     = i_colFBO,
          size      = size.normal,
          text      = "FBO",
          textcolor = color.white)

// Linea prezzo di entrata durante la posizione aperta
plot(strategy.position_size != 0 ? strategy.position_avg_price : na,
     title     = "Entry Price",
     color     = color.new(color.yellow, 0),
     linewidth = 1,
     style     = plot.style_linebr)

// ── Pannello informazioni ─────────────────────────────────────────────────────
if i_showTable and barstate.islast
    var table infoTable = table.new(
         position     = position.top_right,
         columns      = 2,
         rows         = 12,
         bgcolor      = color.new(color.black, 75),
         border_color = color.new(color.gray, 50),
         border_width = 1)

    // Header
    table.cell(infoTable, 0, 0, "SEARCH FB",
         text_color=color.white, text_size=size.small,
         bgcolor=color.new(#2962FF, 30), text_halign=text.align_center)
    table.cell(infoTable, 1, 0, timeframe.period + " min",
         text_color=color.white, text_size=size.small,
         bgcolor=color.new(#2962FF, 30), text_halign=text.align_center)

    // Stato FB (Long)
    string bdStatus = inBD ?
         "⚠️ BD (" + str.tostring(bar_index - bdBar) + "/" + str.tostring(i_maxBars) + " barre)" :
         (strategy.position_size > 0 ? "✅ IN LONG" : "👁 In attesa")
    color bdColor = inBD ? color.red : (strategy.position_size > 0 ? color.green : color.gray)
    table.cell(infoTable, 0, 1, "Stato FB",   text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 1, bdStatus,     text_color=bdColor,      text_size=size.tiny)

    // Livello BD
    table.cell(infoTable, 0, 2, "Livello BD", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 2,
         inBD ? str.tostring(bdLevel, "#.##") : "—",
         text_color=color.yellow, text_size=size.tiny)

    // Stato FBO (Short)
    string boStatus = inBO ?
         "⚠️ BO (" + str.tostring(bar_index - boBar) + "/" + str.tostring(i_maxBarsH) + " barre)" :
         (strategy.position_size < 0 ? "✅ IN SHORT" : "👁 In attesa")
    color boColor = inBO ? color.orange : (strategy.position_size < 0 ? color.red : color.gray)
    table.cell(infoTable, 0, 3, "Stato FBO",  text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 3, boStatus,     text_color=boColor,      text_size=size.tiny)

    // Livello BO
    table.cell(infoTable, 0, 4, "Livello BO", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 4,
         inBO ? str.tostring(boLevel, "#.##") : "—",
         text_color=color.orange, text_size=size.tiny)

    // Minimi attivi
    int nLvl = array.size(sl_lvl)
    table.cell(infoTable, 0, 5, "Minimi attivi", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 5,
         str.tostring(nLvl) + " / " + str.tostring(i_maxLows),
         text_color=color.white, text_size=size.tiny)

    // Massimi attivi
    int nHgh = array.size(sh_lvl)
    table.cell(infoTable, 0, 6, "Massimi attivi", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 6,
         str.tostring(nHgh) + " / " + str.tostring(i_maxHighs),
         text_color=color.white, text_size=size.tiny)

    // Ultimi livelli SL
    string lvlStr = ""
    if nLvl > 0
        for i = 0 to math.min(nLvl - 1, 2)
            lvlStr := lvlStr + str.tostring(array.get(sl_lvl, i), "#.##")
            if i < math.min(nLvl - 1, 2)
                lvlStr := lvlStr + " | "
    else
        lvlStr := "—"
    table.cell(infoTable, 0, 7, "Ultimi SL",  text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 7, lvlStr,       text_color=color.aqua,   text_size=size.tiny)

    // Ultimi livelli SH
    string hghStr = ""
    if nHgh > 0
        for i = 0 to math.min(nHgh - 1, 2)
            hghStr := hghStr + str.tostring(array.get(sh_lvl, i), "#.##")
            if i < math.min(nHgh - 1, 2)
                hghStr := hghStr + " | "
    else
        hghStr := "—"
    table.cell(infoTable, 0, 8, "Ultimi SH",  text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 8, hghStr,       text_color=color.orange, text_size=size.tiny)

    // Parametri pivot FB
    table.cell(infoTable, 0, 9, "Pivot FB L/R", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 9,
         str.tostring(i_pivLeft) + " / " + str.tostring(i_pivRight),
         text_color=color.white, text_size=size.tiny)

    // Parametri pivot FBO
    table.cell(infoTable, 0, 10, "Pivot FBO L/R", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 10,
         str.tostring(i_pivLeftH) + " / " + str.tostring(i_pivRightH),
         text_color=color.white, text_size=size.tiny)

    // R:R e tick stop
    table.cell(infoTable, 0, 11, "R:R  FB / FBO", text_color=color.silver, text_size=size.tiny)
    table.cell(infoTable, 1, 11,
         str.tostring(i_rrRatio, "#.#") + " / " + str.tostring(i_rrRatioH, "#.#"),
         text_color=color.white, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════
//  A L E R T   C O N D I T I O N S
// ════════════════════════════════════════════════════════════════════════════

// ── FB Long ───────────────────────────────────────────────────────────────────
alertcondition(fbSignal,
     title   = "Search FB – Segnale Failed Breakdown",
     message = "⚡ FAILED BREAKDOWN su {{ticker}} [{{interval}}]\n" +
               "Close: {{close}}\nVerifica entry, SL e target sul grafico.")

alertcondition(inBD and not inBD[1],
     title   = "Search FB – Breakdown in corso",
     message = "⚠️ Breakdown su {{ticker}} [{{interval}}]\n" +
               "Prezzo sceso sotto Minimo Significativo.\nIn attesa del recupero...")

alertcondition(not inBD and inBD[1] and not fbSignal,
     title   = "Search FB – Breakdown confermato (FB fallito)",
     message = "❌ Breakdown REALE su {{ticker}} [{{interval}}]\n" +
               "Il prezzo NON ha recuperato – livello rimosso.")

// ── FBO Short ─────────────────────────────────────────────────────────────────
alertcondition(fboSignal,
     title   = "Search FB – Segnale Failed Breakout",
     message = "⚡ FAILED BREAKOUT su {{ticker}} [{{interval}}]\n" +
               "Close: {{close}}\nVerifica entry, SL e target sul grafico.")

alertcondition(inBO and not inBO[1],
     title   = "Search FB – Breakout in corso",
     message = "⚠️ Breakout su {{ticker}} [{{interval}}]\n" +
               "Prezzo salito sopra Massimo Significativo.\nIn attesa del rientro...")

alertcondition(not inBO and inBO[1] and not fboSignal,
     title   = "Search FB – Breakout confermato (FBO fallito)",
     message = "❌ Breakout REALE su {{ticker}} [{{interval}}]\n" +
               "Il prezzo NON è rientrato – livello rimosso.")
